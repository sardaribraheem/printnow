# Public project URL and publishable key from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to the exact deployed origin (e.g. https://your-project.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server/worker only; use a rotated key through secure environment settings.
PRINTNOW_SUPABASE_SERVER_KEY=
# Optional cloud Node networking (set before Node starts).
NODE_USE_ENV_PROXY=1
# Development sandbox bindings are created by npm run sandbox.
# They are ignored in production; never point them at a remote database.
