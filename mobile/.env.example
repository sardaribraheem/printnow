# Public values only. Never add a service-role or secret key to a mobile build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reachable HTTPS origin serving the Next.js mobile API.
EXPO_PUBLIC_API_URL=
# Optional EAS project UUID required for Expo push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
